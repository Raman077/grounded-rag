# Copy to .env. Every setting is optional; see libs/core/src/rag_core/config.py for all of them.

# --- Storage ---------------------------------------------------------------
# http(s) URL for a Qdrant server, ":memory:", or a folder for embedded Qdrant (no Docker needed)
RAG_QDRANT_LOCATION=./data/qdrant
# RAG_QDRANT_API_KEY=

# --- Embeddings ------------------------------------------------------------
RAG_EMBEDDING_PROVIDER=fastembed           # fastembed | voyage | hashing
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIM=384
# RAG_VOYAGE_API_KEY=
# Minimum similarity for a chunk to count as relevant; re-calibrate when the embedding model changes
RAG_MIN_RELEVANCE_SCORE=0.55

# --- Generation ------------------------------------------------------------
# opencode: local dev through `opencode serve` (see README). anthropic: production default.
RAG_LLM_PROVIDER=opencode
RAG_OPENCODE_URL=http://127.0.0.1:4096
RAG_OPENCODE_MODEL=openrouter/qwen/qwen3.8-27b:free
# RAG_OPENCODE_PASSWORD=
# ANTHROPIC_API_KEY=
# RAG_GENERATION_MODEL=claude-sonnet-5

# --- Auth --------------------------------------------------------------------
# Required when RAG_ENVIRONMENT=prod
# RAG_JWT_SECRET=

# --- Tracing (OTLP/HTTP: Jaeger, Langfuse, ...) -------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 public:secret>
